# Copy to /home/SITE_USER/rail-sahayak.env  and fill in.  chmod 600 that file.
SARVAM_API_KEY=
ADMIN_KEY=
ADMIN_WHATSAPP=91XXXXXXXXXX
PUBLIC_URL=https://train.example.com

# One WhatsApp channel:
CALLMEBOT_APIKEY=
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_TEMPLATE_NAME=
# NOTIFY_WEBHOOK_URL=

# Where the SQLite database lives (outside htdocs so it is never web-served)
DATA_DIR=/home/SITE_USER/rail-data

# Optional off-server backup to a private Hugging Face dataset
# HF_TOKEN=
# HF_DATASET_REPO=yourname/rail-bookings

# Optional voice tuning
# SARVAM_TTS_SPEAKER=priya
# SARVAM_TTS_PACE=0.9
